# ---------------------------------------------------------------------------
# NEBULA — git ignore
#
# IMPORTANT — directory patterns are ANCHORED (leading "/") unless they name a
# tool-generated directory.
#
# Why this matters: a bare `lib/` pattern matches at ANY depth, and it once
# silently ignored `frontend/lib/` (the typed API client), so a fresh clone
# failed with "Module not found: Can't resolve '@/lib/api'". Anything sourced
# from a Python .gitignore template (`lib/`, `build/`, `dist/`, `var/`,
# `parts/`, `sdist/`, `wheels/`, `eggs/`, `downloads/`) must stay anchored to
# the repository root, because those names are also perfectly normal JavaScript
# source directories.
#
# Verify before pushing:  make verify-tracked   (or)
#   comm -23 <(find . -type f -not -path './.git/*' -not -path '*/node_modules/*' \
#     -not -path '*/.next/*' -not -path '*/__pycache__/*' | sed 's|^\./||' | sort) \
#     <(git ls-files | sort)
# ---------------------------------------------------------------------------

# --- secrets & local config (NEVER commit) ---------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- databases / runtime data ----------------------------------------------
backend/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
.e2e-*.db*

# --- Python -----------------------------------------------------------------
# tool-generated directory names (safe unanchored — never source dirs)
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.tox/
# build artefacts — ANCHORED to the repo root so a JS `lib/` or `build/`
# directory elsewhere in the tree is never ignored by accident
/build/
/dist/
/lib/
/lib64/
/sdist/
/wheels/
/eggs/
/parts/
/var/
/downloads/
/develop-eggs/
.installed.cfg
*.egg
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
.vercel/
.eslintcache
.npm/
.npmrc
# next-env.d.ts is regenerated by Next.js on dev/build and is intentionally ignored
next-env.d.ts
*.tsbuildinfo

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
\#*\#
.\#*

# --- logs -------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*

# --- docker -----------------------------------------------------------------
data/postgres/
