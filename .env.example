# ---------------------------------------------------------------------------
# NEBULA V1 — environment template.  Copy to .env and edit.
# All backend settings use the NEBULA_ prefix (see backend/app/config.py).
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
NEBULA_ENVIRONMENT=development
NEBULA_VERSION=1.0.0

# PostgreSQL in docker-compose; SQLite fallback for local dev
# NEBULA_DATABASE_URL=postgresql+psycopg2://nebula:nebula@db:5432/nebula
NEBULA_DATABASE_URL=sqlite:///./data/nebula.db

# --- auth -------------------------------------------------------------------
# MUST be replaced in production (min 32 chars). Generate: openssl rand -hex 32
NEBULA_JWT_SECRET=change-me-nebula-development-secret-0123456789abcdef
NEBULA_ACCESS_TOKEN_EXPIRE_MINUTES=1440
NEBULA_SEED_DEMO_USER=true
NEBULA_DEMO_USER_EMAIL=demo@nebula.ai
NEBULA_DEMO_USER_PASSWORD=nebula-demo-2024

# --- agent limits (bounded execution) ---------------------------------------
NEBULA_MAX_STEPS=25
NEBULA_MAX_TASK_MINUTES=10
NEBULA_MAX_RETRIES=2
NEBULA_STEP_TIMEOUT_SECONDS=45
NEBULA_APPROVAL_TIMEOUT_SECONDS=600
NEBULA_OBSERVATION_TEXT_LIMIT=4000
NEBULA_MAX_INTERACTIVE_ELEMENTS=80

# --- browser ----------------------------------------------------------------
NEBULA_BROWSER_HEADLESS=true
NEBULA_BROWSER_VIEWPORT_WIDTH=1280
NEBULA_BROWSER_VIEWPORT_HEIGHT=800

# --- security: global domain allowlist (JSON array) -------------------------
NEBULA_ALLOWED_DOMAINS=["localhost","127.0.0.1","example.com","www.example.com","en.wikipedia.org"]
# Origin of the built-in deterministic demo website served by the backend
NEBULA_DEMO_SITE_ORIGIN=http://localhost:8000
NEBULA_CORS_ORIGINS=["http://localhost:3000"]

# --- AI provider (heuristic = fully offline deterministic agent) ------------
NEBULA_LLM_PROVIDER=heuristic
NEBULA_OPENAI_API_KEY=
NEBULA_OPENAI_MODEL=gpt-4o-mini
NEBULA_OPENAI_BASE_URL=https://api.openai.com/v1
NEBULA_ANTHROPIC_API_KEY=
NEBULA_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- frontend ---------------------------------------------------------------
# Where the frontend server proxies /api and /ws
BACKEND_URL=http://127.0.0.1:8000
PORT=3000
